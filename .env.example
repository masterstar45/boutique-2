# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SUPER_ADMIN_ID=
TELEGRAM_SUPER_ADMIN_IDS=
TELEGRAM_ADMIN_CHAT_ID=

# ─── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL=
# Validation stricte du certificat TLS de la base (A1).
# - Fournir le CA (PEM) => validation stricte, anti-MITM. Recommandé si dispo.
# DATABASE_CA_CERT=
# - Sinon, forcer la validation même sans CA fourni :
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ─── Confidentialité / anonymat ────────────────────────────────────────────────
# Chiffrement au repos des PII (adresse, téléphone, notes) — AES-256-GCM (P5).
# Laisser vide = pas de chiffrement (les données restent en clair).
# Une fois définie, NE PAS la perdre : sans elle les données chiffrées sont illisibles.
# Après l'avoir définie, migrer l'existant : pnpm --filter @workspace/scripts run encrypt-pii
ENCRYPTION_KEY=
# Sel de masquage des identifiants dans les logs (P3/P4). Optionnel :
# à défaut, TELEGRAM_BOT_TOKEN est utilisé comme sel.
# LOG_SALT=
# Délai (jours) avant anonymisation des commandes livrées/annulées (P2). Défaut 30.
# ORDER_ANONYMIZE_DAYS=30

# ─── Redis (rate limiting distribué — recommandé en production multi-instance) ─
REDIS_URL=

# ─── Cloudinary (stockage vidéo CDN) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Google Cloud Storage (images produits) ───────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Cloudflare Turnstile (CAPTCHA checkout) ──────────────────────────────────
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# ─── URLs ──────────────────────────────────────────────────────────────────────
APP_URL=
MINI_APP_URL=
RAILWAY_PUBLIC_DOMAIN=
VITE_APP_URL=

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=

# ─── Serveur ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Dev uniquement ────────────────────────────────────────────────────────────
# ALLOW_UNSIGNED_MINIAPP_AUTH=true
